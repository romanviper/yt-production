{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnerGuidedReview",
  "description": "Diagnostic owner-review UX. Not benchmark-valid blind preference evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "sample_id",
    "eval_unit_id",
    "mode",
    "benchmark_evidence_eligible",
    "micro_units",
    "session_summary"
  ],
  "$defs": {
    "ownerLabel": {
      "type": "string",
      "enum": ["MATCHES_TARGET", "PARTIAL", "MISSES_TARGET", "WRONG_TARGET", "UNCERTAIN"]
    },
    "featureName": {
      "type": "string",
      "enum": [
        "INFORMATION_RELEASE",
        "LISTENER_ORIENTATION",
        "FORWARD_PRESSURE",
        "CONCRETENESS_FUNCTION",
        "NARRATOR_STANCE",
        "LOCAL_TRANSFORMATION",
        "SPOKEN_LOAD"
      ]
    },
    "featureComparison": {
      "type": "object",
      "required": [
        "feature",
        "candidate_behavior",
        "target_behavior_ref",
        "target_behavior",
        "overlap",
        "gap",
        "confidence",
        "medium_limitation",
        "owner_label"
      ],
      "properties": {
        "feature": {"$ref": "#/$defs/featureName"},
        "candidate_behavior": {"type": "string", "minLength": 1},
        "target_behavior_ref": {"type": "string", "minLength": 1},
        "target_behavior": {"type": "string", "minLength": 1},
        "overlap": {"type": "string"},
        "gap": {"type": "string"},
        "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
        "medium_limitation": {"type": "string", "minLength": 1},
        "owner_label": {"anyOf": [{"$ref": "#/$defs/ownerLabel"}, {"type": "null"}]},
        "owner_note": {"type": ["string", "null"]},
        "owner_preferred_behavior": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "review_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "eval_unit_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "const": "GUIDED_TARGET_DIAGNOSTIC"},
    "benchmark_evidence_eligible": {"type": "boolean", "const": false},
    "micro_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "candidate_excerpt",
          "declared_function",
          "boundary_basis",
          "feature_comparisons",
          "owner_unit_note"
        ],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "candidate_excerpt": {"type": "string", "minLength": 1},
          "declared_function": {"type": "string", "minLength": 1},
          "boundary_basis": {"type": "string", "minLength": 1},
          "feature_comparisons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {"$ref": "#/$defs/featureComparison"}
          },
          "owner_unit_note": {"type": ["string", "null"]},
          "owner_boundary_correction": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "session_summary": {
      "type": "object",
      "required": ["recurring_gaps", "wrong_targets", "unresolved", "scalar_score"],
      "properties": {
        "recurring_gaps": {"type": "array", "items": {"type": "string"}},
        "wrong_targets": {"type": "array", "items": {"type": "string"}},
        "unresolved": {"type": "array", "items": {"type": "string"}},
        "scalar_score": {"type": "null"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
