{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase1TargetGapAnalysis",
  "description": "Lane C only: post-preference comparison against function-matched CRAFT_ONLY references. This record cannot modify the frozen Product pairwise verdict.",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "product_evaluation_ref",
    "product_evaluation_frozen",
    "sample_id",
    "matched_function",
    "references",
    "observations",
    "remaining_gaps",
    "retained_strengths",
    "medium_limitation",
    "retroactive_preference_change"
  ],
  "$defs": {
    "span": {
      "type": "object",
      "required": ["source", "quote"],
      "properties": {
        "source": {"type": "string", "enum": ["SAMPLE", "REFERENCE"]},
        "quote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "analysis_id": {"type": "string", "minLength": 1},
    "product_evaluation_ref": {"type": "string", "minLength": 1},
    "product_evaluation_frozen": {"type": "boolean", "const": true},
    "sample_id": {"type": "string", "minLength": 1},
    "matched_function": {"type": "string", "minLength": 1},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reference_id", "authority", "function_match", "medium"],
        "properties": {
          "reference_id": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "const": "CRAFT_ONLY_NOT_TRUTH"},
          "function_match": {"type": "string", "minLength": 1},
          "medium": {"type": "string", "enum": ["TRANSCRIPT_ONLY", "AUDIO_VERIFIED"]}
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sample_span", "reference_span", "similarity", "difference", "uncertainty"],
        "properties": {
          "sample_span": {"$ref": "#/$defs/span"},
          "reference_span": {"$ref": "#/$defs/span"},
          "similarity": {"type": "string"},
          "difference": {"type": "string", "minLength": 1},
          "uncertainty": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "remaining_gaps": {"type": "array", "items": {"type": "string"}},
    "retained_strengths": {"type": "array", "items": {"type": "string"}},
    "medium_limitation": {"type": "string", "minLength": 1},
    "retroactive_preference_change": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
