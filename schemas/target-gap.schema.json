{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase1TargetGapAnalysis",
  "description": "Post-vote functional comparison against CRAFT_ONLY references. It cannot change the frozen Product preference and cannot score style similarity.",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "eval_unit_id",
    "candidate_id",
    "product_preference_ref",
    "product_preference_frozen",
    "reference_visible_during_primary_vote",
    "matched_editorial_function",
    "functional_target",
    "candidate_achieves_function",
    "references",
    "observable_gap",
    "candidate_spans",
    "abstract_craft_observation",
    "style_similarity_used_as_score",
    "imitation_risk",
    "medium_limitation",
    "retroactive_preference_change"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "analysis_id": {"type": "string", "minLength": 1},
    "eval_unit_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "product_preference_ref": {"type": "string", "minLength": 1},
    "product_preference_frozen": {"type": "boolean", "const": true},
    "reference_visible_during_primary_vote": {"type": "boolean", "const": false},
    "matched_editorial_function": {"type": "string", "minLength": 1},
    "functional_target": {"type": "string", "minLength": 1},
    "candidate_achieves_function": {"type": "string", "enum": ["YES", "PARTIAL", "NO"]},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reference_id", "authority", "function_match", "medium", "reference_span"],
        "properties": {
          "reference_id": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "const": "CRAFT_ONLY_NOT_TRUTH"},
          "function_match": {"type": "string", "minLength": 1},
          "medium": {"type": "string", "enum": ["TRANSCRIPT_ONLY", "AUDIO_VERIFIED"]},
          "reference_span": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "observable_gap": {"type": "string", "minLength": 1},
    "candidate_spans": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "abstract_craft_observation": {"type": "string", "minLength": 1},
    "retained_strengths": {"type": "array", "items": {"type": "string"}},
    "style_similarity_used_as_score": {"type": "boolean", "const": false},
    "imitation_risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "medium_limitation": {"type": "string", "minLength": 1},
    "retroactive_preference_change": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
