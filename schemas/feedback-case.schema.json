{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeedbackCase",
  "type": "object",
  "required": [
    "schema_version", "case_id", "source_run_id", "source_commit", "standard", "baseline", "candidate",
    "symptom", "trace", "intervention", "plan_change", "evidence_ceiling", "measurement_scope",
    "invariants", "acceptance_rule", "comparison_ref", "measurement_status"
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["raw_sha256", "bytes", "text_sha256", "text_normalization"],
      "properties": {
        "raw_sha256": {"type": "string", "minLength": 64},
        "bytes": {"type": "integer"},
        "text_sha256": {"type": ["string", "null"]},
        "text_normalization": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "refIdentity": {
      "type": "object",
      "required": ["ref", "identity"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "identity": {"$ref": "#/$defs/identity"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"type": "string"},
    "case_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": ["string", "null"]},
    "standard": {
      "type": "object",
      "required": ["brief", "product_contract", "target_profile", "product_review_blinding"],
      "properties": {
        "brief": {"$ref": "#/$defs/refIdentity"},
        "product_contract": {"$ref": "#/$defs/refIdentity"},
        "target_profile": {"$ref": "#/$defs/refIdentity"},
        "product_review_blinding": {"type": "string", "const": "DIAGNOSTIC_HYPOTHESIS_HIDDEN_PRE_VOTE"}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["id", "source_ref", "identity"],
      "properties": {
        "id": {"type": "string"}, "source_ref": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["id", "source_ref", "identity", "independence"],
      "properties": {
        "id": {"type": "string"}, "source_ref": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"},
        "independence": {"type": "string", "enum": ["NONE", "PARTIAL", "INDEPENDENT"]}
      },
      "additionalProperties": false
    },
    "symptom": {
      "type": "object",
      "required": ["id", "failure_id", "baseline_quote"],
      "properties": {"id": {"type": "string"}, "failure_id": {"type": "string"}, "baseline_quote": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["mapping_status", "mapping_confidence", "suspected_regions", "attribution_confidence", "authority"],
      "properties": {
        "mapping_status": {"type": "string"},
        "mapping_confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
        "suspected_regions": {"type": "array", "items": {"type": "string", "enum": ["PLAN", "WRITE", "TRUTH", "PRODUCT"]}},
        "attribution_confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
        "authority": {"type": "string"}
      },
      "additionalProperties": false
    },
    "intervention": {
      "type": "object",
      "required": ["id", "scope", "identity"],
      "properties": {"id": {"type": "string"}, "scope": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}},
      "additionalProperties": false
    },
    "plan_change": {
      "type": "object",
      "required": ["allowed_beat_ids", "changed_beat_ids", "materialized_plan_ref"],
      "properties": {
        "allowed_beat_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "changed_beat_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "materialized_plan_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence_ceiling": {"type": "string"},
    "measurement_scope": {"type": "string"},
    "invariants": {"type": "object"},
    "acceptance_rule": {"type": "string", "minLength": 1},
    "comparison_ref": {"type": "string"},
    "measurement_status": {"type": "string", "enum": ["AWAITING_MEASUREMENT", "MEASURED"]}
  },
  "additionalProperties": false
}
