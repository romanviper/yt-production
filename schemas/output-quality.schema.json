{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase1OutputQualityEvaluation",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "evaluation_kind",
    "contract_version",
    "evidence_medium",
    "absolute_gates",
    "pairwise_criteria",
    "defect_annotations",
    "failure_signature",
    "target_gap"
  ],
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNCERTAIN"]
    },
    "pairwiseResult": {
      "type": "string",
      "enum": ["A", "B", "TIE", "UNCERTAIN", "NOT_APPLICABLE"]
    },
    "medium": {
      "type": "string",
      "enum": ["TEXT_PREDICTION", "AUDIO_OBSERVATION", "LISTENER_REPORT"]
    },
    "severity": {
      "type": "string",
      "enum": ["MINOR", "MAJOR", "CRITICAL"]
    },
    "span": {
      "type": "object",
      "required": ["sample", "quote"],
      "properties": {
        "sample": {"type": "string", "enum": ["A", "B", "REFERENCE"]},
        "quote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gateEvaluation": {
      "type": "object",
      "required": ["status", "spans", "observation", "uncertainty"],
      "properties": {
        "status": {"$ref": "#/$defs/gateStatus"},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "observation": {"type": "string"},
        "uncertainty": {"type": "string"}
      },
      "additionalProperties": false
    },
    "criterionEvaluation": {
      "type": "object",
      "required": ["result", "spans", "observation", "interpretation", "uncertainty"],
      "properties": {
        "result": {"$ref": "#/$defs/pairwiseResult"},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "observation": {"type": "string"},
        "interpretation": {"type": "string"},
        "uncertainty": {"type": "string"},
        "not_applicable_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "defectAnnotation": {
      "type": "object",
      "required": ["defect", "severity", "span", "observation", "consequence", "uncertainty"],
      "properties": {
        "defect": {
          "type": "string",
          "pattern": "^(TRUTH|PROGRESSION|EXPOSITION|CONNECTION|SPOKEN)\\.[A-Z0-9_]+$"
        },
        "severity": {"$ref": "#/$defs/severity"},
        "span": {"$ref": "#/$defs/span"},
        "observation": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "evaluation_kind": {"type": "string", "enum": ["PAIRWISE_PRODUCT", "SINGLE_DIAGNOSTIC"]},
    "contract_version": {"type": "string", "minLength": 1},
    "evidence_medium": {"$ref": "#/$defs/medium"},
    "samples": {
      "type": "object",
      "properties": {
        "A": {"type": "string"},
        "B": {"type": "string"}
      },
      "additionalProperties": false
    },
    "absolute_gates": {
      "type": "object",
      "required": ["G_TRUTH", "G_COHERENCE", "G_SCOPE", "G_LANGUAGE"],
      "properties": {
        "G_TRUTH": {"$ref": "#/$defs/gateEvaluation"},
        "G_COHERENCE": {"$ref": "#/$defs/gateEvaluation"},
        "G_SCOPE": {"$ref": "#/$defs/gateEvaluation"},
        "G_LANGUAGE": {"$ref": "#/$defs/gateEvaluation"}
      },
      "additionalProperties": false
    },
    "pairwise_criteria": {
      "type": "object",
      "required": ["continue", "movement", "specificity", "connections", "spoken_comprehension", "payoff"],
      "properties": {
        "continue": {"$ref": "#/$defs/criterionEvaluation"},
        "movement": {"$ref": "#/$defs/criterionEvaluation"},
        "specificity": {"$ref": "#/$defs/criterionEvaluation"},
        "connections": {"$ref": "#/$defs/criterionEvaluation"},
        "spoken_comprehension": {"$ref": "#/$defs/criterionEvaluation"},
        "payoff": {"$ref": "#/$defs/criterionEvaluation"}
      },
      "additionalProperties": false
    },
    "defect_annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/defectAnnotation"}
    },
    "failure_signature": {
      "type": "object",
      "required": ["signature_id", "primary_defect", "supporting_defects", "spans", "severity", "observation", "uncertainty"],
      "properties": {
        "signature_id": {"type": "string", "minLength": 1},
        "primary_defect": {"type": ["string", "null"]},
        "supporting_defects": {"type": "array", "items": {"type": "string"}},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "severity": {"type": ["string", "null"], "enum": ["MINOR", "MAJOR", "CRITICAL", null]},
        "observation": {"type": "string"},
        "uncertainty": {"type": "string"}
      },
      "additionalProperties": false
    },
    "target_gap": {
      "type": "object",
      "required": ["matched_reference_id", "matched_function", "candidate_spans", "reference_spans", "similarities", "differences", "remaining_gap", "retained_strengths", "medium_limitation"],
      "properties": {
        "matched_reference_id": {"type": ["string", "null"]},
        "matched_function": {"type": ["string", "null"]},
        "candidate_spans": {"type": "array", "items": {"type": "string"}},
        "reference_spans": {"type": "array", "items": {"type": "string"}},
        "similarities": {"type": "array", "items": {"type": "string"}},
        "differences": {"type": "array", "items": {"type": "string"}},
        "remaining_gap": {"type": "array", "items": {"type": "string"}},
        "retained_strengths": {"type": "array", "items": {"type": "string"}},
        "medium_limitation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "diagnostic_hypothesis": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["NOT_ASSESSED", "TENTATIVE"]},
        "suspected_regions": {"type": "array", "items": {"type": "string"}},
        "basis_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
