{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase1ProductPairwiseEvaluation",
  "description": "Lane B only: black-box Product pairwise preference. Truth and target-gap outputs use separate schemas.",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "contract_version",
    "evidence_medium",
    "samples",
    "pairwise_criteria",
    "defect_annotations",
    "failure_signature"
  ],
  "$defs": {
    "pairwiseResult": {
      "type": "string",
      "enum": ["A", "B", "TIE", "UNCERTAIN", "NOT_APPLICABLE"]
    },
    "medium": {
      "type": "string",
      "enum": ["TEXT_PREDICTION", "AUDIO_OBSERVATION", "LISTENER_REPORT"]
    },
    "severity": {
      "type": "string",
      "enum": ["MINOR", "MAJOR", "CRITICAL"]
    },
    "span": {
      "type": "object",
      "required": ["sample", "quote"],
      "properties": {
        "sample": {"type": "string", "enum": ["A", "B"]},
        "quote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "criterionEvaluation": {
      "type": "object",
      "required": ["result", "spans", "observation", "interpretation", "uncertainty"],
      "properties": {
        "result": {"$ref": "#/$defs/pairwiseResult"},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "observation": {"type": "string"},
        "interpretation": {"type": "string"},
        "uncertainty": {"type": "string"},
        "not_applicable_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "defectAnnotation": {
      "type": "object",
      "required": ["defect", "severity", "span", "observation", "consequence", "uncertainty"],
      "properties": {
        "defect": {
          "type": "string",
          "pattern": "^(PROGRESSION|EXPOSITION|CONNECTION|SPOKEN)\\.[A-Z0-9_]+$"
        },
        "severity": {"$ref": "#/$defs/severity"},
        "span": {"$ref": "#/$defs/span"},
        "observation": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "evidence_medium": {"$ref": "#/$defs/medium"},
    "samples": {
      "type": "object",
      "required": ["A", "B"],
      "properties": {
        "A": {"type": "string", "minLength": 1},
        "B": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pairwise_criteria": {
      "type": "object",
      "required": ["continue", "movement", "specificity", "connections", "spoken_comprehension", "payoff"],
      "properties": {
        "continue": {"$ref": "#/$defs/criterionEvaluation"},
        "movement": {"$ref": "#/$defs/criterionEvaluation"},
        "specificity": {"$ref": "#/$defs/criterionEvaluation"},
        "connections": {"$ref": "#/$defs/criterionEvaluation"},
        "spoken_comprehension": {"$ref": "#/$defs/criterionEvaluation"},
        "payoff": {"$ref": "#/$defs/criterionEvaluation"}
      },
      "additionalProperties": false
    },
    "defect_annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/defectAnnotation"}
    },
    "failure_signature": {
      "type": "object",
      "required": ["signature_id", "primary_defect", "supporting_defects", "spans", "severity", "observation", "uncertainty"],
      "properties": {
        "signature_id": {"type": "string", "minLength": 1},
        "primary_defect": {"type": ["string", "null"]},
        "supporting_defects": {"type": "array", "items": {"type": "string"}},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "severity": {"type": ["string", "null"], "enum": ["MINOR", "MAJOR", "CRITICAL", null]},
        "observation": {"type": "string"},
        "uncertainty": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
